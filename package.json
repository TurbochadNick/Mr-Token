{
  "name": "token-tithe",
  "version": "0.1.0",
  "description": "Local-first Claude Code hook collector and terminal token audit CLI.",
  "type": "module",
  "bin": {
    "mrtoken": "./dist/cli.js",
    "token-tithe": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "tokenTithe": {
    "ai": {
      "enabled": false,
      "model": "claude-haiku-4-5",
      "redaction": true
    }
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && vite build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "commander": "^12.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
